    {
      "name": "4. Booking REST APIs",
      "item": [
        {
          "name": "TC18 - Create Valid Reservation",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Subtotal and Service Fee calculation is accurate', function () {",
                  "    pm.expect(json.data.serviceFee).to.eql(500);",
                  "    pm.expect(json.data.totalAmount).to.eql(json.data.subtotal + 500);",
                  "    pm.expect(json.data.bookingReference).to.match(/^SW-BK-[0-9]{5}$/);",
                  "});",
                  "pm.collectionVariables.set('bookingId', json.data._id);",
                  "pm.collectionVariables.set('bookingReference', json.data.bookingReference);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"hotelId\": \"hotel-1\",\n  \"guestName\": \"Aarav Sharma\",\n  \"email\": \"guest@staywise.com\",\n  \"phone\": \"+91 98765 99887\",\n  \"checkIn\": \"2026-12-15\",\n  \"checkOut\": \"2026-12-17\",\n  \"guests\": 2,\n  \"adults\": 2,\n  \"children\": 0,\n  \"rooms\": 1\n}"
            },
