      "name": "1. Authentication & RBAC",
      "item": [
        {
          "name": "TC01 - Register Guest User",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created or 200 OK', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});",
                  "var json = pm.response.json();",
                  "pm.test('Returns JWT token and user info', function () {",
                  "    pm.expect(json.success).to.be.true;",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.expect(json.user.role).to.eql('guest');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Traveler\",\n  \"email\": \"traveler_{{$timestamp}}@example.com\",\n  \"password\": \"Traveler@123456\",\n  \"phone\": \"+91 98765 00001\",\n  \"role\": \"guest\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/auth/register", "host": ["{{baseUrl}}"], "path": ["auth", "register"] }
          }
        },
        {
          "name": "TC02 - Register Hotel Manager User",
          "event": [
            {
              "listen": "test",
              "script": {
